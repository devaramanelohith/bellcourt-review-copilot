# Which provider to use: openrouter or gemini
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Optional. Defaults: google/gemini-2.5-flash (openrouter), gemini-2.5-flash (gemini)
LLM_MODEL=
AUTH_SECRET=
# Optional: persistence and email (see docs/SETUP_DATABASE_AND_EMAIL.md)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
LETTER_TO_EMAIL=
